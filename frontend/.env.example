# FloodTwin Frontend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# Google Maps JavaScript API key.
# Required for the interactive map to load.
# Restrict this key to your domain and to the Maps JavaScript API only.
VITE_GOOGLE_MAPS_API_KEY=

# Google Maps Map ID (optional).
# Enables vector map features: 3D buildings, tilt, heading, and custom styles.
# Create a Map ID in the Google Cloud Console under "Google Maps Platform > Map Management".
VITE_GOOGLE_MAPS_MAP_ID=
